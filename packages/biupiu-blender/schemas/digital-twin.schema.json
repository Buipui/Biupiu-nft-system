{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Biupiu Digital Twin Blender Adapter Record",
  "type": "object",
  "required": ["biupiu_id", "version", "asset_type"],
  "properties": {
    "biupiu_id": {"type": "string"},
    "version": {"type": "string"},
    "asset_type": {"type": "string"},
    "geometry": {"type": "object"},
    "materials": {"type": "array", "items": {"type": "object"}},
    "simulation": {"type": "object"},
    "research_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_classification": {"type": "string"},
    "asset_hash": {"type": "string"}
  },
  "additionalProperties": true
}
