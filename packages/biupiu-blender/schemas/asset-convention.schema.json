{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Biupiu Asset Convention",
  "type": "object",
  "required": ["biupiu_id", "asset_type", "units", "axis", "evidence_state", "provenance", "licence_status"],
  "properties": {
    "biupiu_id": {"type": "string", "pattern": "^BPU-[A-Z0-9._-]+$"},
    "asset_type": {"enum": ["character", "environment", "product", "prop", "material"]},
    "units": {"const": "metres"},
    "axis": {"type": "object", "required": ["forward", "up"], "properties": {"forward": {"const": "+Y"}, "up": {"const": "+Z"}}},
    "rig_id": {"type": ["string", "null"]},
    "evidence_state": {"type": "string"},
    "provenance": {"type": "string"},
    "licence_status": {"type": "string"},
    "digital_twin_ref": {"type": ["string", "null"]},
    "lod_targets": {"type": "array", "items": {"enum": ["DESKTOP_MASTER", "ANDROID_LOD2", "ANDROID_LOD3"]}}
  }
}
