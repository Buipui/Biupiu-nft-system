# Adobe Firefly Services — server-side configuration only
# Never commit a real secret. .env files are ignored by the repository.

FIREFLY_SERVICES_CLIENT_ID=
FIREFLY_SERVICES_CLIENT_SECRET=
FIREFLY_SERVICES_TOKEN_URL=https://ims-na1.adobelogin.com/ims/token/v3
FIREFLY_SERVICES_SCOPE=openid,AdobeID,session,additional_info,read_organizations,firefly_api,ff_apis
