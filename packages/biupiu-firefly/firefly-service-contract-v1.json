{
  "schema": "biupiu.firefly.service.v1",
  "provider": "adobe-firefly",
  "apiSpecification": {
    "source": "AdobeDocs/ffs-firefly-api",
    "sourceUrl": "https://raw.githubusercontent.com/AdobeDocs/ffs-firefly-api/main/static/firefly-api.json",
    "path": "static/firefly-api.json",
    "openapi": "3.1.0",
    "apiVersion": "3.0.0",
    "productionBaseUrl": "https://firefly-api.adobe.io",
    "verificationMode": "credential-free-static-contract-check"
  },
  "package": "@biupiu/firefly",
  "scope": "CREATIVE_AI",
  "clientAuthority": false,
  "credentialBoundary": "server-only-live-runtime",
  "operations": [
    "GENERATE_IMAGE",
    "GENERATE_IMAGE5",
    "EXPAND_IMAGE",
    "FILL_IMAGE",
    "OBJECT_COMPOSITE",
    "PRECISE_COMPOSITE",
    "ADAPTIVE_COMPOSITE",
    "SIMILAR_IMAGES",
    "UPSCALE",
    "GENERATE_VIDEO",
    "UPLOAD_ASSET"
  ],
  "modelVersions": [
    "image3",
    "image3_custom",
    "image4_standard",
    "image4_ultra",
    "image4_custom",
    "image5",
    "video1_standard",
    "precise_upsampler_v1"
  ],
  "accessErrors": [
    "quota_exhausted",
    "user_non_entitled",
    "user_profile_denied",
    "invalid_ims_scope"
  ],
  "provenance": {
    "researchId": "required-when-research-linked",
    "projectId": "required",
    "sourceAssetId": "tracked-when-used",
    "prompt": "tracked-when-applicable",
    "jobId": "tracked",
    "outputAssetId": "tracked",
    "outputHash": "required-before-release"
  },
  "releasePolicy": {
    "nftStudio": "release-gated",
    "publicPublication": "human-approved",
    "scientificEvidence": "not-automatic"
  },
  "clients": [
    "android",
    "windows",
    "web"
  ],
  "delivery": {
    "resultUrl": "provider-supplied",
    "downloadMode": "direct-presigned-or-temporary-url",
    "credentialFreeDownload": true,
    "downloadOperation": "GET",
    "provenanceCaptureRequiredBeforeRelease": true
  }
}
