{
  "name": "biupiu-nft-system",
  "version": "1.2.0",
  "private": true,
  "description": "Biupiu NFT smart contracts, deployment tooling, minting scripts and research-linked provenance architecture.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.js --network hardhat",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:amoy": "hardhat run scripts/deploy.js --network polygonAmoy",
    "mint:sepolia": "hardhat run scripts/mint.js --network sepolia",
    "mint:amoy": "hardhat run scripts/mint.js --network polygonAmoy"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "hardhat": "^2.22.19"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2"
  }
}
