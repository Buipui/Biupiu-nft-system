{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BPU.SCHEMA.INFORMATION.GROWTH.1.0",
  "title": "Biupiu Multidimensional Information Growth Model",
  "type": "object",
  "required": ["model_id","version","state","dimensions","graph","metrics","learning","governance"],
  "properties": {
    "model_id": {"const":"BPU.MODEL.INFORMATION.GROWTH"},
    "version": {"const":"1.0"},
    "state": {"enum":["REGISTERED","SOURCE_IMPLEMENTED","TESTS_ADDED","RUNTIME_OPEN","VERIFIED"]},
    "dimensions": {"type":"array","minItems":1,"items":{"type":"object","required":["id","role"],"properties":{"id":{"type":"string"},"role":{"type":"string"},"weight":{"type":"number","minimum":0}}}},
    "graph": {"type":"object","required":["nodes","edges"],"properties":{"nodes":{"type":"integer","minimum":0},"edges":{"type":"integer","minimum":0}}},
    "metrics": {"type":"object","required":["source_objects","metadata_records","graph_nodes","graph_edges","archive_units","growth_rate"],"properties":{"source_objects":{"type":"integer","minimum":0},"metadata_records":{"type":"integer","minimum":0},"graph_nodes":{"type":"integer","minimum":0},"graph_edges":{"type":"integer","minimum":0},"archive_units":{"type":"integer","minimum":0},"growth_rate":{"type":"number"},"graph_density":{"type":"number","minimum":0},"metadata_density":{"type":"number","minimum":0}}},
    "learning": {"type":"object","required":["features","target","scaling"],"properties":{"features":{"type":"array","items":{"type":"string"}},"target":{"type":"string"},"scaling":{"enum":["LINEAR","MULTIDIMENSIONAL","ADAPTIVE"]}}},
    "governance": {"type":"object","required":["metadata_is_not_validation","hash_is_not_truth","promotion_fail_closed"],"properties":{"metadata_is_not_validation":{"const":true},"hash_is_not_truth":{"const":true},"promotion_fail_closed":{"const":true}}}
  }
}