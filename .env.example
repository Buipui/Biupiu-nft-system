# NEVER COMMIT .env or private keys.
# Copy this file to .env locally.

SEPOLIA_RPC_URL=https://YOUR_RPC_PROVIDER/sepolia
POLYGON_AMOY_RPC_URL=https://YOUR_RPC_PROVIDER/polygon-amoy
DEPLOYER_PRIVATE_KEY=YOUR_PRIVATE_KEY_WITHOUT_QUOTES

# Deployment parameters
COLLECTION_NAME=BIUPIU / ORIGIN
COLLECTION_SYMBOL=BIU
MAX_SUPPLY=10000
ROYALTY_RECEIVER=YOUR_PUBLIC_WALLET_ADDRESS
ROYALTY_BPS=500

# Minting
RECIPIENT=YOUR_PUBLIC_WALLET_ADDRESS
TOKEN_URI=ipfs://REPLACE_WITH_METADATA_CID/1.json
