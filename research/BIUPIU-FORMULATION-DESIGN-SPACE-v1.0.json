{
  "schema":"BIUPIU-FORMULATION-DESIGN-SPACE-v1.0",
  "gate":"BM-07",
  "status":"research-design",
  "candidate_id_pattern":"BMF-{RUN}-{NNNN}",
  "variables":{
    "fibre_id":{"type":"reference","source":"BIUPIU-MATERIALS-GENOME"},
    "resin_formulation_id":{"type":"reference","source":"BIUPIU-RESIN-FORMULATION-SCHEMA"},
    "fibre_volume_fraction":{"type":"range","unit":"fraction","required_source":true},
    "fibre_treatment":{"type":"categorical","values":["untreated","alkali","silane","bio-based","physical","other-documented"]},
    "fibre_orientation":{"type":"categorical","values":["UD","biaxial","woven","hybrid"]},
    "ply_sequence":{"type":"structured","required":true},
    "basalt_fraction":{"type":"range","unit":"fraction","required_source":true},
    "core_id":{"type":"reference","required":false},
    "manufacturing_route":{"type":"categorical","values":["infusion","compression","prepreg","other-validated"]},
    "cure_profile_id":{"type":"reference","required":true},
    "conditioning":{"type":"categorical","values":["ambient","humidity","water","thermal-cycle","UV","combined"]},
    "geometry_id":{"type":"reference","source":"blade-geometry-record","required":true},
    "load_case_ids":{"type":"array","source":"BIUPIU-BLADE-BASELINE-DATASET","required":true}
  },
  "objectives":["mass","tip_deflection","peak_stress_or_strain","natural_frequency","buckling_margin","fatigue_damage_indicator","moisture_sensitivity","thermal_sensitivity","manufacturing_complexity","cost","embodied_impact_indicator"],
  "constraints":{
    "missing_required_input":"REJECT_FROM_SIMULATION",
    "unknown_allowable":"DO_NOT_ASSUME_PASS",
    "traceability_required":true,
    "same_geometry_for_comparison":true,
    "same_load_cases_for_comparison":true,
    "same_boundary_conditions_for_comparison":true,
    "safety_factor_must_be_explicit":true
  },
  "evidence_states":["T0-literature-candidate","T1-material-coupon","T2-laminate-coupon","T3-component","T4-rotating-subassembly","T5-controlled-prototype","T6-integrated-system","T7-representative-environment","T8-independent-replication","T9-production-qualified"],
  "candidate_status":["GENERATED","SIMULATION-READY","SIMULATED","UNCERTAINTY-REVIEW","PARETO-CANDIDATE","TEST-QUEUED","TESTED","CALIBRATED","REPLICATION-REQUIRED","DISQUALIFIED-DATA","DISQUALIFIED-CONSTRAINT"],
  "provenance_required":["generator_version","generation_seed","material_record_version","resin_record_version","geometry_version","model_version","solver_version","load_case_versions","manufacturing_route","operator_or_process_owner","timestamp"],
  "candidate_record":{
    "candidate_id":"string",
    "variables":"object",
    "objective_outputs":"object-or-null",
    "uncertainty":"object-or-null",
    "evidence_state":"string",
    "status":"string",
    "source_refs":"array",
    "test_refs":"array",
    "simulation_refs":"array",
    "notes":"string"
  }
}