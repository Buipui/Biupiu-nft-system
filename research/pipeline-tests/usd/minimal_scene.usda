#usda 1.0
(
    defaultPrim = "BiupiuScene"
    startTimeCode = 1
    endTimeCode = 48
    timeCodesPerSecond = 24
)

def Xform "BiupiuScene" {
    custom string biupiuResearchId = "BIUPIU-ANIM-GATE1-001"
    def Xform "Environment" {}
    def Xform "VehiclePlaceholder" {
        double3 xformOp:translate.timeSamples = {1: (0, 0, 0), 48: (2, 0, 0)}
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Camera "AnimatedCamera" {
        float focalLength = 50
        double3 xformOp:translate.timeSamples = {1: (0, 3, 8), 48: (2, 3, 7)}
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
