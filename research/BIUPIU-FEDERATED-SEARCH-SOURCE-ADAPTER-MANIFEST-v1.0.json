    {"id":"GITHUB","class":"primary/discovery","purpose":"public repository and code discovery"},
    {"id":"ISO_STANDARDS","class":"authoritative","purpose":"published standards and lifecycle state"},
    {"id":"NASA_ADS","class":"authoritative_index","purpose":"scientific literature discovery and metadata"},
    {"id":"GOV_TECH","class":"authoritative","purpose":"public government technical research"},
    {"id":"SCHOLARLY_INDEX","class":"metadata","purpose":"cross-publisher scholarly discovery"},
    {"id":"OPEN_ACCESS_REPO","class":"discovery","purpose":"open technical/scientific documents"},
    {"id":"OFFICIAL_PROJECT_DOCS","class":"primary","purpose":"project APIs, specifications and implementation documentation"},
    {"id":"FOREIGN_LANGUAGE","class":"discovery","purpose":"native-language technical discovery"},
