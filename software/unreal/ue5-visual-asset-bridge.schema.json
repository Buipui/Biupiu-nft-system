{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biupiu-ue5-visual-asset-bridge.schema.json",
  "title": "Biupiu UE5 Visual Asset Bridge",
  "type": "object",
  "required": ["asset_id", "visual_manifest", "ue5"],
  "properties": {
    "asset_id": {"type":"string"},
    "visual_manifest": {
      "type":"object",
      "required":["asset_id","asset_type","source","licence","files","provenance","pipeline"],
      "properties": {
        "asset_id":{"type":"string"},
        "asset_type":{"type":"string"},
        "source":{"type":"object"},
        "licence":{"type":"object","required":["status"]},
        "files":{"type":"array"},
        "provenance":{"type":"object","required":["acquired_at","transformation_log"]},
        "pipeline":{"type":"object","required":["authoring","targets"]}
      }
    },
    "ue5": {
      "type":"object",
      "required":["project","asset_path","engine_major"],
      "properties": {
        "project":{"type":"string"},
        "asset_path":{"type":"string"},
        "engine_major":{"type":"integer","const":5}
      }
    }
  }
}