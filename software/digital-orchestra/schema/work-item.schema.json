{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Biupiu Digital Orchestra Work Item",
  "type":"object",
  "required":["title","capability","evidence","provenance","state","correlation_id"],
  "properties":{
    "title":{"type":"string","minLength":1},
    "capability":{"type":"string","minLength":1},
    "evidence":{"enum":["ESTABLISHED","SUPPORTED","PRELIMINARY","HYPOTHESIS","SPECULATIVE","CONTRADICTED","INCONCLUSIVE"]},
    "state":{"enum":["DISCOVERED","CLASSIFIED","PLANNED","ROUTED","EXECUTING","OBSERVED","VERIFIED","DIGESTED","FILED","LEARNED","PROMOTED","QUARANTINED"]},
    "correlation_id":{"type":"string"},
    "provenance":{"type":"object","required":["source_uri","source_kind","language","licence"],"additionalProperties":true},
    "inputs":{"type":"object"},"outputs":{"type":"object"},"history":{"type":"array"}
  },
  "additionalProperties":true
}
